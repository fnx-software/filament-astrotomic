{
    "name": "fnx-software/filament-astrotomic",
    "description": "Filament support for Astrotomic's Laravel Translatable package.",
    "keywords": [
        "FenixSoftware",
        "fnx-software",
        "laravel",
        "filament-astrotomic",
        "astrotomic",
        "laravel-translatable",
        "filament",
        "translatable",
        "translations",
        "filamentastrotomic"
    ],
    "homepage": "https://github.com/fnx-software/filament-astrotomic",
    "support": {
        "issues": "https://github.com/fnx-software/filament-astrotomic/issues",
        "source": "https://github.com/fnx-software/filament-astrotomic"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Moustafa Khazaal",
            "email": "mstfkhazaal@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "astrotomic/laravel-translatable": "^11.16",
        "filament/filament": "^4.0",
        "filament/forms": "^4.0",
        "filament/tables": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Fnxsoftware\\FilamentAstrotomic\\": "src/",
            "Fnxsoftware\\FilamentAstrotomic\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fnxsoftware\\FilamentAstrotomic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fnxsoftware\\FilamentAstrotomic\\FilamentAstrotomicServiceProvider"
            ],
            "aliases": {
                "FilamentAstrotomic": "Fnxsoftware\\FilamentAstrotomic\\Facades\\FilamentAstrotomic"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
